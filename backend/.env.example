# Stripe — get from dashboard.stripe.com
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...           # the $6/month recurring price you create in Stripe

# Upstash Redis — get from console.upstash.com
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# Gemini — get from aistudio.google.com. Powers the free tier always, and
# Pro/Enterprise/trial too if ANTHROPIC_API_KEY below is unset or Anthropic
# is unreachable (see backend/lib/geminiModel.js).
GEMINI_API_KEY=...

# Anthropic — get from console.anthropic.com. Powers Pro/Enterprise/trial
# (Claude Haiku 4.5) — see backend/lib/anthropicModel.js. Optional: if unset,
# unmetered traffic just runs on Gemini like the free tier does.
ANTHROPIC_API_KEY=sk-ant-...


# Your deployed Vercel URL (no trailing slash)
APP_URL=https://openpilot.tenlabs.io

# ── Paddle (payments, replacing Stripe/Xendit) ───────────────────────────────
# Sandbox first: sandbox-vendors.paddle.com. For go-live swap every value below
# for its live equivalent (live IDs differ from sandbox) and set PADDLE_ENV=production.
PADDLE_ENV=sandbox
# Developer Tools > Notifications > your destination > Secret key (pdl_ntfset_...)
PADDLE_WEBHOOK_SECRET=pdl_ntfset_...
# Developer Tools > Authentication > API keys. Read-only "Customers" is enough: used
# only to look up the buyer's email, since webhook payloads carry customer_id only.
PADDLE_API_KEY=...
# Price ids (pri_...) from Catalog > Prices. Must match the ids in freebird-upgrade.html.
PADDLE_PRICE_PRO_MONTHLY=pri_...
PADDLE_PRICE_PRO_ANNUAL=pri_...
PADDLE_PRICE_TEMPLATES=pri_...
PADDLE_PRICE_TEAM=pri_...

# Signs the GitHub session tokens and the checkout link tokens. Already required by
# api/auth-github.js; the same value is used here.
AUTH_SECRET=...
# Where api/link-token.js sends signed-in buyers. Default shown.
CHECKOUT_PAGE_URL=https://ten-labs.com.au/freebird-upgrade.html
