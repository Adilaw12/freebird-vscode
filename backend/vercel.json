{
  "functions": {
    "api/*.js": { "maxDuration": 45 }
  },
  "rewrites": [
    { "source": "/success", "destination": "/api/success" },
    { "source": "/upgrade", "destination": "/api/upgrade-page" },
    { "source": "/dashboard", "destination": "/api/dashboard" },
    { "source": "/share/:id", "destination": "/api/share?id=:id" }
  ]
}
